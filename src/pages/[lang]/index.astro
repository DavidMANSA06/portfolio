---
/**
 * Page d'accueil, générée en deux versions : /fr/ et /en/.
 * Chaque section a son composant ; son contenu vient de src/content/ (YAML) ou de src/i18n/ui.ts.
 * L'ordre du menu et les ancres viennent de src/config/site.ts.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import About from '../../components/About.astro';
import CertificationGrid from '../../components/CertificationGrid.astro';
import Contact from '../../components/Contact.astro';
import EducationGrid from '../../components/EducationGrid.astro';
import ExperienceTimeline from '../../components/ExperienceTimeline.astro';
import Landing from '../../components/Landing.astro';
import PlatformList from '../../components/PlatformList.astro';
import ProjectsBand from '../../components/ProjectsBand.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Section from '../../components/Section.astro';
import Sidebar from '../../components/Sidebar.astro';
import SkillGrid from '../../components/SkillGrid.astro';
import { sectionNumber } from '../../config/site';
import { languages, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = (() =>
  Object.keys(languages).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('site.title')}
  description={t('site.description')}
  bodyClass="has-landing"
>
  <ReadingProgress />
  <Sidebar lang={lang} current="home" />
  <Landing lang={lang} />

  <main class="with-sidebar">
    <Section
      id="a-propos"
      number={sectionNumber('a-propos')}
      eyebrow={t('nav.about')}
      title={t('about.title')}
      centered
    >
      <About lang={lang} />
    </Section>

    <Section
      id="competences"
      number={sectionNumber('competences')}
      eyebrow={t('nav.skills')}
      title={t('skills.title')}
      lead={t('skills.lead')}
    >
      <SkillGrid lang={lang} />
    </Section>

    <Section
      id="experiences"
      number={sectionNumber('experiences')}
      eyebrow={t('nav.experience')}
      title={t('experience.title')}
      lead={t('experience.lead')}
    >
      <ExperienceTimeline lang={lang} />
    </Section>

    <Section
      id="formations"
      number={sectionNumber('formations')}
      eyebrow={t('nav.education')}
      title={t('education.title')}
      lead={t('education.lead')}
    >
      <EducationGrid lang={lang} />
    </Section>

    <Section
      id="certifications"
      number={sectionNumber('certifications')}
      eyebrow={t('nav.certifications')}
      title={t('certifications.title')}
      lead={t('certifications.lead')}
    >
      <CertificationGrid lang={lang} />
      <PlatformList lang={lang} />
    </Section>

    <ProjectsBand lang={lang} />
    <Contact lang={lang} />
  </main>
</BaseLayout>
