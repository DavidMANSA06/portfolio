---
/**
 * Page d'accueil, générée en deux versions : /fr/ et /en/.
 * 5.1 : l'accueil plein écran est en place.
 * Les sections ci-dessous sont des emplacements vides, remplis PR après PR
 * (sidebar, À propos, Compétences, Expériences…).
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/Landing.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = (() =>
  Object.keys(languages).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('site.title')} description={t('site.description')}>
  <Landing lang={lang} />

  <main>
    <section class="section" id="a-propos">
      <h2>{t('section.about')}</h2>
      <p class="wip">{t('section.wip')}</p>
    </section>

    <section class="section" id="contact">
      <h2>{t('section.contact')}</h2>
      <p class="wip">{t('section.wip')}</p>
    </section>
  </main>
</BaseLayout>

<style>
  /* Styles provisoires des sections vides : remplacés au fil des PR */
  .section {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 96px 24px;
  }

  .wip {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
</style>
