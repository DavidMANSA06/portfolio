---
/**
 * Page d'accueil, générée en deux versions : /fr/ et /en/.
 * - 5.1 : accueil plein écran ; 5.3 : sidebar, barre de progression, cadre des sections.
 * Les sections sont encore vides : elles se remplissent PR après PR.
 * L'ordre et les ancres des sections viennent de src/config/site.ts.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/Landing.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Section from '../../components/Section.astro';
import Sidebar from '../../components/Sidebar.astro';
import { sections } from '../../config/site';
import { languages, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = (() =>
  Object.keys(languages).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Toutes les sections sauf « Accueil » (qui est le Landing)
const contentSections = sections.filter((s) => s.id !== 'accueil');
---

<BaseLayout
  lang={lang}
  title={t('site.title')}
  description={t('site.description')}
  bodyClass="has-landing"
>
  <ReadingProgress />
  <Sidebar lang={lang} current="home" />
  <Landing lang={lang} />

  <main class="with-sidebar">
    {contentSections.map((s, i) => (
      <Section id={s.id} number={i + 1} eyebrow={t(s.key)} title={t(s.key)}>
        <p class="wip">{t('section.wip')}</p>
      </Section>
    ))}
  </main>
</BaseLayout>

<style>
  /* Texte provisoire des sections vides : disparaît au fil des PR */
  .wip {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
</style>
