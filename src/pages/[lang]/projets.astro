---
/**
 * Page Projets : /fr/projets/ et /en/projets/.
 * Emplacement provisoire pour que le bouton « Mes projets » ne mène pas à une 404.
 * Le vrai contenu (études de cas + filtres) arrive dans une PR dédiée.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { languages, localizePath, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = (() =>
  Object.keys(languages).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('projects.title')} — Mansa David Gocaley`}
  description={t('site.description')}
>
  <main class="page">
    <div class="tools">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
    </div>
    <h1>{t('projects.title')}</h1>
    <p class="wip">{t('section.wip')}</p>
    <a href={localizePath(lang)}>← {t('projects.back')}</a>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 96px 24px;
  }

  .tools {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: -0.04em;
    margin: 24px 0 8px;
  }

  .wip {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
</style>
