---
/**
 * Page Projets : /fr/projets/ et /en/projets/.
 * Emplacement provisoire (avec la sidebar) pour que « Mes projets » ne mène pas à une 404.
 * Le vrai contenu (études de cas + filtres) arrive dans une PR dédiée.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { languages, localizePath, useTranslations, type Lang } from '../../i18n/ui';

export const getStaticPaths = (() =>
  Object.keys(languages).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('projects.title')} — Mansa David Gocaley`}
  description={t('site.description')}
>
  <Sidebar lang={lang} current="projects" />

  <main class="page with-sidebar">
    <h1>{t('projects.title')}</h1>
    <p class="wip">{t('section.wip')}</p>
    <a href={localizePath(lang)}>← {t('projects.back')}</a>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--content-max) + 160px);
    padding: 104px 80px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: -0.04em;
    margin: 0 0 8px;
  }

  .wip {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .page {
      padding: 96px 16px 72px;
    }
  }
</style>
