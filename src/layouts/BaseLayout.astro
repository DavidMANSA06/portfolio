---
/**
 * BaseLayout : le squelette HTML commun à toutes les pages.
 * Chaque page l'utilise ainsi :
 *   <BaseLayout lang="fr" title="…" description="…"> contenu </BaseLayout>
 */
import '@fontsource-variable/geist'; // polices hébergées avec le site (aucun CDN tiers)
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * Content Security Policy : la liste blanche de ce que le navigateur a le droit de charger.
 * Tout vient du site lui-même ('self') : aucun script, style, police ou image externe,
 * et aucun code écrit directement dans la page. Une injection (XSS) ne pourrait donc rien exécuter.
 * Uniquement en production : en développement, Vite injecte des scripts en ligne pour le
 * rechargement à chaud, que cette CSP bloquerait.
 * À l'étape 8, Nginx enverra la même règle en en-tête HTTP (plus complète : frame-ancestors…).
 */
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <!-- Thème clair / sombre appliqué avant l'affichage : voir public/theme-init.js -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL('/fr/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <slot />
  </body>
</html>
