---
/**
 * BaseLayout : le squelette HTML commun à toutes les pages.
 * Chaque page l'utilise ainsi :
 *   <BaseLayout lang="fr" title="…" description="…"> contenu </BaseLayout>
 * bodyClass (optionnel) : classe ajoutée à <body>, ex. "has-landing" sur l'accueil.
 * noindex (optionnel) : demande aux moteurs de recherche de ne pas indexer la page (404).
 *
 * Open Graph : l'aperçu (titre, description, image) affiché quand le lien est partagé
 * sur LinkedIn, Slack, WhatsApp… L'image est public/og.png (1200 × 630).
 */
import '@fontsource-variable/geist'; // polices hébergées avec le site (aucun CDN tiers)
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { languages, switchLangPath, type Lang } from '../i18n/ui';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { lang, title, description, bodyClass, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogLocales: Record<Lang, string> = { fr: 'fr_FR', en: 'en_GB' };
const ogSubtitle: Record<Lang, string> = {
  fr: 'Cybersécurité & DevSecOps',
  en: 'Cybersecurity & DevSecOps',
};
const langs = Object.keys(languages) as Lang[];

/*
 * Content Security Policy : la liste blanche de ce que le navigateur a le droit de charger.
 * Tout vient du site lui-même ('self') : aucun script, style, police ou image externe,
 * et aucun code écrit directement dans la page. Une injection (XSS) ne pourrait donc rien exécuter.
 * Uniquement en production : en développement, Vite injecte des scripts en ligne pour le
 * rechargement à chaud, que cette CSP bloquerait.
 * À l'étape 8, Nginx enverra la même règle en en-tête HTTP (plus complète : frame-ancestors…).
 */
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <!-- Thème clair / sombre appliqué avant l'affichage : voir public/theme-init.js -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {/* La même page dans chaque langue (pour les moteurs de recherche) */}
        {langs.map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(switchLangPath(Astro.url.pathname, l), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(switchLangPath(Astro.url.pathname, 'fr'), Astro.site)}
        />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Aperçu lors d'un partage (Open Graph, repris aussi par X/Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${ogSubtitle[lang]}`} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {langs
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocales[l]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
