---
/**
 * ExperienceTimeline : la frise des expériences (src/content/experiences/*.yaml).
 * Triée de la plus récente à la plus ancienne ; les brouillons (draft: true) sont ignorés.
 */
import { getCollection } from 'astro:content';
import { byStartDesc, formatRange } from '../lib/dates';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = (await getCollection('experiences', ({ data }) => !data.draft)).sort(byStartDesc);
---

<ol class="timeline">
  {items.map(({ data }) => (
    <li class="item reveal">
      <p class="meta">
        <span class="type">
          {t(`type.${data.type}`)}
          {data.duration && ` · ${data.duration[lang]}`}
        </span>
        <span>{formatRange(lang, data.start, data.end)}</span>
      </p>
      <h3>{data.title[lang]}</h3>
      <p class="org">
        {data.organization} · {data.location}
      </p>
      <ul class="points">
        {data.points[lang].map((point) => (
          <li>{point}</li>
        ))}
      </ul>
      {data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 36px;
  }

  /* La ligne verticale de la frise */
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .item {
    position: relative;
    padding-bottom: 48px;
  }

  .item:last-child {
    padding-bottom: 0;
  }

  /* Le point sur la frise */
  .item::before {
    content: '';
    position: absolute;
    left: -36px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin: 0 0 6px;
  }

  .type {
    padding: 1px 8px;
    border-radius: 4px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10.5px;
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 2px;
  }

  .org {
    color: var(--color-muted);
    font-size: 15px;
    margin: 0 0 12px;
  }

  .points {
    margin: 0 0 14px;
    padding-left: 18px;
    font-size: 15px;
  }

  .points li {
    margin-bottom: 4px;
  }

  .points li::marker {
    color: var(--color-accent);
  }
</style>
