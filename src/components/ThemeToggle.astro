---
/**
 * ThemeToggle : bouton clair / sombre.
 * - Le thème initial est posé par public/theme-init.js (avant l'affichage).
 * - Le clic bascule le thème, le mémorise (localStorage) et l'anime en cercle
 *   depuis le bouton (View Transitions API), comme dans la maquette.
 * - aria-pressed="true" = thème sombre actif (lu par les lecteurs d'écran).
 * - Sans JavaScript, le bouton est masqué : il ne servirait à rien.
 */
import { useTranslations, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  class="icon-btn theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label={t('theme.label')}
>
  <Icon name="moon" class="moon" />
  <Icon name="sun" class="sun" />
</button>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  const current = (): Theme => (root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  function setTheme(theme: Theme, remember: boolean) {
    root.setAttribute('data-theme', theme);
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(theme === 'dark')));
    if (remember) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* stockage indisponible : le choix vaut pour cette page seulement */
      }
    }
  }

  function hasStoredChoice(): boolean {
    try {
      return localStorage.getItem('theme') !== null;
    } catch {
      return false;
    }
  }

  // État initial du bouton (le thème lui-même est déjà posé par theme-init.js)
  setTheme(current(), false);

  // Tant que le visiteur n'a rien choisi, on suit le réglage du système en direct
  media.addEventListener('change', (e) => {
    if (!hasStoredChoice()) setTheme(e.matches ? 'dark' : 'light', false);
  });

  buttons.forEach((btn) =>
    btn.addEventListener('click', (e) => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      const apply = () => setTheme(next, true);

      // Navigateur sans View Transitions, ou « réduire les animations » : bascule simple
      if (!document.startViewTransition || reduceMotion) return apply();

      // Le nouveau thème s'ouvre en cercle depuis le point de clic
      const rect = btn.getBoundingClientRect();
      const x = e.clientX || rect.left + rect.width / 2;
      const y = e.clientY || rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      document.startViewTransition(apply).ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          {
            duration: 550,
            easing: 'cubic-bezier(.2,.8,.2,1)',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      });
    }),
  );
</script>

<style>
  /* Masqué sans JavaScript (la classe "js" est ajoutée par theme-init.js) */
  .theme-toggle {
    display: none;
  }
  :global(.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle :global(.icon) {
    transition: transform 0.5s var(--ease-out);
  }
  .theme-toggle:hover :global(.icon) {
    transform: rotate(-25deg);
  }

  /* Clair : on montre la lune (« passer en sombre ») ; sombre : le soleil */
  .theme-toggle :global(.sun) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.sun) {
    display: block;
  }
  :global([data-theme='dark']) .theme-toggle :global(.moon) {
    display: none;
  }
</style>
