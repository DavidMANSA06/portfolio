---
/**
 * CertificationGrid : les cartes de certification (src/content/certifications/*.yaml).
 * Obtenues d'abord, puis en préparation ; chacune triée de la plus récente à la plus ancienne.
 * S'il n'y en a aucune (hors brouillons), un message d'attente s'affiche.
 */
import { getCollection } from 'astro:content';
import { formatYearMonth } from '../lib/dates';
import { useTranslations, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = (await getCollection('certifications', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(a.data.status === 'en-preparation') - Number(b.data.status === 'en-preparation') ||
    b.data.date.localeCompare(a.data.date),
);
---

{items.length === 0 ? (
  <p class="empty">{t('certifications.empty')}</p>
) : (
  <div class="grid">
    {items.map(({ data }) => (
      <article class="card reveal">
        <div class="top">
          <span class="badge-icon">
            <Icon name="award" />
          </span>
          <span class:list={['status', data.status === 'obtenue' ? 'done' : 'wip']}>
            {t(`cert.status.${data.status}`)}
          </span>
        </div>
        <h3>{data.name[lang]}</h3>
        <p class="issuer">{data.issuer}</p>
        <div class="foot">
          <span>
            {data.status === 'en-preparation' && `${t('cert.planned')} `}
            {formatYearMonth(lang, data.date)}
          </span>
          {data.verifyUrl ? (
            <a href={data.verifyUrl} target="_blank" rel="noopener noreferrer">
              {t('cert.verify')} ↗<span class="visually-hidden"> {t('link.newTab')}</span>
            </a>
          ) : (
            <span aria-hidden="true">—</span>
          )}
        </div>
      </article>
    ))}
  </div>
)}

<style>
  .empty {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .badge-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .badge-icon :global(.icon) {
    width: 22px;
    height: 22px;
  }

  /* Pastille de statut : vert = obtenue, orange = en préparation */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .done {
    color: var(--color-ok);
  }

  .wip {
    color: var(--color-wip);
  }

  h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 4px;
  }

  .issuer {
    color: var(--color-muted);
    font-size: 14.5px;
    margin: 0 0 20px;
  }

  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px dashed var(--color-border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }

  @media (max-width: 1180px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
