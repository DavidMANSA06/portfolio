---
/**
 * Button : un lien qui ressemble à un bouton.
 *   <Button href="#contact">Contact</Button>                     → plein (accent)
 *   <Button href="/fr/projets/" variant="ghost" arrow>Projets</Button> → contour + flèche
 */
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  arrow?: boolean;
}

const { href, variant = 'primary', arrow = false } = Astro.props;
---

<a class:list={['btn', `btn-${variant}`]} href={href}>
  <slot />
  {arrow && (
    <span class="arrow" aria-hidden="true">
      →
    </span>
  )}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 500;
    border: 1px solid transparent;
    transition:
      transform 0.15s,
      border-color 0.15s;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-ghost {
    border-color: var(--color-border);
    color: var(--color-text);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .btn-ghost:hover {
    border-color: var(--color-text);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-out);
  }

  .btn:hover .arrow {
    transform: translateX(3px);
  }
</style>
