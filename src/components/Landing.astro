---
/**
 * Landing : l'accueil plein écran (sans sidebar), repris de la maquette v0.6.
 * Textes : src/i18n/ui.ts (clés "landing.*").
 * Le bouton de thème clair / sombre arrivera dans la PR suivante (5.2).
 */
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="landing" id="accueil">
  <div class="landing-tools">
    <LangSwitch lang={lang} />
  </div>

  <div class="intro">
    <p class="pill">
      <Icon name="shield" />
      {t('landing.pill')}
    </p>
    <h1>
      Mansa David Gocaley
      <span class="sub">{t('landing.subtitle')}</span>
    </h1>
    <p class="lead">{t('landing.lead')}</p>
    <div class="actions">
      <Button href="#a-propos">{t('landing.cta.about')}</Button>
      <Button href={localizePath(lang, 'projets/')} variant="ghost" arrow>
        {t('landing.cta.projects')}
      </Button>
      <Button href="#contact" variant="ghost">
        {t('landing.cta.contact')}
      </Button>
    </div>
  </div>

  <a class="scroll-hint" href="#a-propos">
    {t('landing.scroll')}
    <Icon name="chevron-down" />
  </a>
</header>

<style>
  .landing {
    min-height: 100vh;
    min-height: 100svh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 96px 24px 140px;
  }

  .landing-tools {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    gap: 8px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--glass-bg);
    border: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-muted);
    margin: 0 0 28px;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* :global() car le <svg> est rendu par le composant Icon */
  .pill :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--color-accent);
  }

  h1 {
    font-size: clamp(44px, 7vw, 96px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.045em;
    margin: 0 0 20px;
  }

  .sub {
    display: block;
    color: var(--color-accent);
    font-size: 0.45em;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }

  .lead {
    font-size: 19px;
    color: var(--color-muted);
    max-width: 600px;
    margin: 0 auto 40px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: max-content;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .scroll-hint:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Entrée en cascade au chargement (désactivée si "réduire les animations") */
  .intro > * {
    animation: rise 0.9s var(--ease-out) both;
  }
  .intro > :nth-child(1) {
    animation-delay: 0.05s;
  }
  .intro > :nth-child(2) {
    animation-delay: 0.15s;
  }
  .intro > :nth-child(3) {
    animation-delay: 0.3s;
  }
  .intro > :nth-child(4) {
    animation-delay: 0.42s;
  }
  .scroll-hint {
    animation: rise 0.9s 0.7s var(--ease-out) both;
  }
  .scroll-hint :global(.icon) {
    animation: bounce 1.8s ease-in-out infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }

  @keyframes bounce {
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 900px) {
    .landing-tools {
      top: 14px;
      right: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro > *,
    .scroll-hint,
    .scroll-hint :global(.icon) {
      animation: none;
    }
  }
</style>
