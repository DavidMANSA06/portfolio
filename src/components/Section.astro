---
/**
 * Section : le cadre commun des sections de l'accueil.
 *   <Section id="competences" number={2} eyebrow="Compétences" title="Ma boîte à outils.">
 *     … contenu …
 *   </Section>
 * « eyebrow » = la petite ligne au-dessus du titre (« 02 — Compétences »).
 * « lead » (facultatif) = la phrase d'introduction sous le titre.
 * « centered » (facultatif) = section centrée, avec un grand titre (À propos).
 */
interface Props {
  id: string;
  number: number;
  eyebrow: string;
  title: string;
  lead?: string;
  centered?: boolean;
}

const { id, number, eyebrow, title, lead, centered = false } = Astro.props;
const num = String(number).padStart(2, '0');
---

<section class:list={['section', { centered }]} id={id} aria-labelledby={`${id}-title`}>
  <p class="eyebrow">
    {num} — {eyebrow}
  </p>
  <h2 id={`${id}-title`}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .section {
    max-width: calc(var(--content-max) + 160px);
    padding: 104px 80px;
  }

  .section + .section {
    border-top: 1px solid var(--color-border);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 14px;
  }

  h2 {
    font-size: 40px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 14px;
  }

  .lead {
    color: var(--color-muted);
    max-width: 620px;
    margin: 0 0 48px;
    font-size: 17px;
  }

  /* Variante centrée (À propos) : grand titre, comme dans la maquette */
  .centered {
    text-align: center;
  }

  .centered h2 {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.05;
    margin-bottom: 32px;
  }

  @media (max-width: 900px) {
    .centered h2 {
      font-size: 40px;
    }
  }

  @media (max-width: 900px) {
    .section {
      padding: 72px 16px;
    }

    h2 {
      font-size: 32px;
    }
  }
</style>
